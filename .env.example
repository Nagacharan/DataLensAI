# DataLens AI Environment Configuration

# Server Port
PORT=3001

# Google Gemini API Key (Optional - enables advanced LLM natural language insights and conversational Q&A)
# If not provided, DataLens AI automatically utilizes its built-in Deterministic Analytical Engine
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (default: gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI API Key (alternative provider support)
# OPENAI_API_KEY=your_openai_api_key_here
